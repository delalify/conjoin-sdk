{
  "name": "@conjoin-cloud/expo",
  "version": "0.0.2",
  "type": "module",
  "description": "React Native bindings for Conjoin: native provider, secure-store transport, and the headless auth and data hooks for Expo apps.",
  "author": "Delalify Engineering (https://delalify.com)",
  "license": "MIT",
  "homepage": "https://conjoin.delalify.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conjoin-cloud/conjoin-sdk.git",
    "directory": "sdks/typescript-expo"
  },
  "bugs": {
    "url": "https://github.com/conjoin-cloud/conjoin-sdk/issues"
  },
  "keywords": [
    "sdk",
    "conjoin",
    "typescript",
    "react-native",
    "expo",
    "hooks",
    "auth",
    "billing",
    "storage",
    "relay",
    "developer-platform"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "expo-secure-store": ">=13.0.2",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "expo-secure-store": {
      "optional": true
    }
  },
  "dependencies": {
    "@conjoin-cloud/react-core": "workspace:*",
    "@conjoin-cloud/sdk": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "expo-secure-store": "58.0.2",
    "react": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "scripts": {
    "build": "tsup",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  }
}
